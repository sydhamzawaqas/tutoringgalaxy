# Tutoring Galaxy environment variables.
# Copy to .env.local for development. Never commit real values (.env* is git-ignored; only this file is tracked).
# Anything prefixed NEXT_PUBLIC_ is bundled into browser JavaScript, so it must be safe to publish.

# Public site URL, used for canonical URLs, sitemaps and Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.tutoringgalaxy.com

# --- Supabase --------------------------------------------------------------------------------
# Project URL and anon (public) key. The anon key is safe in the browser ONLY because every table
# has Row Level Security on (see supabase/migrations).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# The same two values, exposed to the browser for the Supabase auth client (@supabase/ssr).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: SERVER ONLY. Bypasses RLS; used to insert leads and tutor applications.
# Never prefix with NEXT_PUBLIC_ and never import it into a client component.
# If SUPABASE_URL or this is missing: in development, trial requests are logged (redacted) and not
# stored; in production, the booking form shows an error asking the family to WhatsApp instead.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI practice -----------------------------------------------------------------------------
# Gemini API key: SERVER ONLY. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Maximum AI practice requests per user per day.
AI_DAILY_LIMIT_PER_USER=50
